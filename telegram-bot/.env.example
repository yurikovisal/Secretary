# Telegram
BOT_TOKEN=123456:ABC-DEF
# Канал для публикации, например @my_channel или -100xxxxxxxxxx
CHANNEL_ID=@your_channel
# Кто может управлять ботом (Telegram user id через запятую). Пусто = любой (только для тестов)
ADMIN_IDS=123456789

# LLM (OpenAI-compatible API)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Поведение
DEFAULT_POST_LENGTH=medium
# draft | publish — publish сразу шлёт в канал после генерации по /post
POST_MODE=draft
# Путь к скиллу (относительно telegram-bot/ или абсолютный)
SKILL_DIR=skill